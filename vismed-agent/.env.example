# Bifrost AI Gateway (On-Premise / Private Server)
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=your_bifrost_api_key_here
BIFROST_CHAT_MODEL=llama.cpp/medgemma-1.5-4b-it-q4
BIFROST_FALLBACK_MODEL=llama.cpp/gemma-4-12b-it-q8
BIFROST_EMBEDDING_MODEL=ollama/snowflake-arctic-embed2:latest

# Local Services & Storage
ONNX_SERVICE_URL=http://127.0.0.1:5000
DICOM_GATEWAY_URL=http://127.0.0.1:4000
